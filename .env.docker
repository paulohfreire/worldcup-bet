# Docker Environment Configuration
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:devpassword@db:5432/worldcup_dev

# JWT Secret (DEVELOPMENT ONLY - usar string forte em produção)
JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars-long

# CSRF Secret (DEVELOPMENT ONLY)
CSRF_SECRET=dev-csrf-secret-change-in-production-min-32-chars-long

# CORS Origins
ALLOWED_ORIGINS=http://localhost:3000

# Database Credentials
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=worldcup_dev
