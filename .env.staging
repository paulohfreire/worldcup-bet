# Staging Environment Configuration
NODE_ENV=production

# Database
# Connection pool settings (connection_limit=10, pool_timeout=20)
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?connection_limit=10&pool_timeout=20

# JWT Secret
JWT_SECRET=your-staging-jwt-secret-minimum-32-characters

# CSRF Secret
CSRF_SECRET=your-staging-csrf-secret-minimum-32-characters

# CORS Origins
ALLOWED_ORIGINS=https://staging.yourdomain.com,http://localhost:3000

# Database Credentials
POSTGRES_PASSWORD=staging-postgres-password
POSTGRES_DB=worldcup_staging

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 4 * * *"  # Daily at 4 AM UTC
BACKUP_RETENTION_DAYS=14
