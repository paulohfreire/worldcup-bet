generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // Connection pool configuration for production
  // URL format: postgresql://user:password@host:port/database?connection_limit=10&pool_timeout=20
}

// Connection pool settings (applied when configured in DATABASE_URL)
// connection_limit: Number of connections in pool (default: 10)
// pool_timeout: Timeout in seconds to get connection from pool (default: 2)
// connect_timeout: Timeout in seconds to establish connection (default: 10)

model User {
  id                  String       @id @default(uuid())
  name                String
  email               String       @unique
  password            String
  role                String       @default("user")
  createdAt           DateTime     @default(now())
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  lastFailedLogin     DateTime?

  predictions         Prediction[]
}

model Team {
  id        String  @id @default(uuid())
  name      String
  code      String
  flagUrl   String
  group     String?

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
}

model Match {
  id              String   @id @default(uuid())
  stage           String
  group           String?
  order           Int
  homeTeamId      String
  awayTeamId      String
  date            DateTime

  homeScore       Int?
  awayScore       Int?

  nextMatchId     String?
  nextMatchSlot   String?  // "home" or "away"

  predictions     Prediction[]

  homeTeam        Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam        Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])

  @@index([nextMatchId])
}

model Prediction {
  id        String @id @default(uuid())
  userId    String
  matchId   String

  homeScore Int
  awayScore Int

  user      User   @relation(fields: [userId], references: [id])
  match     Match  @relation(fields: [matchId], references: [id])

  @@unique([userId, matchId])
  @@index([userId])
  @@index([matchId])
}
